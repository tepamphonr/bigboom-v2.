              ${e.notes ? `<p class="text-xs text-slate-400 mt-1">${escapeHtml(e.notes)}</p>` : ''}
              ${e.slip ? `<img src="${e.slip}" class="w-20 h-20 object-cover rounded-lg border border-slate-200 mt-2">` : ''}

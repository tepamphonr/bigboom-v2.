  e.paid = !e.paid; scheduleSave(); renderContent();
}
function deleteExpense(id){
  askConfirm('ลบรายจ่าย','ต้องการลบรายจ่ายนี้ใช่หรือไม่?', ()=>{
    state.expenses = state.expenses.filter(x=>x.id!==id); scheduleSave(); renderContent(); toast('ลบแล้ว');
  });
}
function uploadExpenseSlip(id, input){
  const file = input.files[0]; if(!file) return;
  if(file.size > 1.2*1024*1024){ toast('ไฟล์สลิปใหญ่เกินไป กรุณาใช้รูปขนาดเล็กกว่า 1.2MB','error'); return; }
  const reader = new FileReader();
  reader.onload = e=>{
    const exp = state.expenses.find(x=>x.id===id);
    exp.slip = e.target.result; exp.paid = true;
    scheduleSave(); renderContent(); toast('บันทึกสลิปและปรับสถานะเป็นจ่ายแล้ว');
  };
  reader.readAsDataURL(file);
}
 
/* ---- LINE notification (LINE Notify ปิดบริการแล้ว ใช้ Messaging API แทน) ---- */
function openLineSettings(){
  document.getElementById('line-token').value = state.lineSettings.token || '';
  document.getElementById('line-userid').value = state.lineSettings.userId || '';
  document.getElementById('line-settings-modal').classList.remove('hidden');
}
function saveLineSettings(){
  state.lineSettings.token = document.getElementById('line-token').value.trim();
  state.lineSettings.userId = document.getElementById('line-userid').value.trim();
  scheduleSave();
  document.getElementById('line-settings-modal').classList.add('hidden');
  toast('บันทึกการตั้งค่า LINE แล้ว');
}
async function testLineNotify(){
  const {token, userId} = state.lineSettings;
  const nearList = state.expenses.filter(e=>!e.paid && daysUntilDue(e.dueDay).diff<=3);
  const message = nearList.length
    ? 'แจ้งเตือนรายจ่ายใกล้ถึงกำหนดชำระ:\n' + nearList.map(e=>`- ${e.name} ฿${fmtMoney(e.amount)} (อีก ${daysUntilDue(e.dueDay).diff} วัน)`).join('\n')
    : 'ไม่มีรายจ่ายที่ใกล้ถึงกำหนดชำระในขณะนี้';
  if(!token || !userId){ toast('กรุณาตั้งค่า Channel Access Token และ User ID ก่อน','error'); openLineSettings(); return; }
  try{
    const res = await fetch('https://api.line.me/v2/bot/message/push', {
      method:'POST',
      headers:{'Content-Type':'application/json','Authorization':'Bearer '+token},
      body: JSON.stringify({to:userId, messages:[{type:'text', text:message}]}),
    });
    if(res.ok){ toast('ส่งแจ้งเตือนไปยัง LINE เรียบร้อยแล้ว'); }
    else{ toast('ส่งแจ้งเตือนไม่สำเร็จ (เซิร์ฟเวอร์ LINE ปฏิเสธคำขอ) — ระบบนี้อาจต้องส่งผ่านเซิร์ฟเวอร์ของร้านแทนการเรียกจากเบราว์เซอร์โดยตรง','error'); }
  }catch(err){
    toast('ส่งแจ้งเตือนไม่สำเร็จ — เบราว์เซอร์ไม่อนุญาตให้เรียก LINE API โดยตรง แนะนำให้ตั้งค่าผ่านเซิร์ฟเวอร์กลางของร้าน','error');
  }
}
 
/* ============================ PETTY CASH / GENERAL EXPENSES ============================ */
let pettyCashDashMonth = todayISO().slice(0,7); // 'YYYY-MM'
function setPettyCashDashMonth(val){ pettyCashDashMonth = val; renderContent(); }
function setPettyCashDashYear(val){ pettyCashDashYear = Number(val); renderContent(); }
let pettyCashDashYear = new Date().getFullYear();
 
function renderPettyCash(c){
  const entries = state.pettyCash.slice().sort((a,b)=> (b.date+((b.time)||'')).localeCompare(a.date+((a.time)||'')));
  const byDay = {};
  entries.forEach(e=>{ byDay[e.date] = (byDay[e.date]||0) + Number(e.amount||0); });
  const monthTotal = state.pettyCash.filter(e=>e.date.slice(0,7)===pettyCashDashMonth).reduce((s,e)=>s+Number(e.amount||0),0);
  const yearTotal = state.pettyCash.filter(e=>e.date.slice(0,4)===String(pettyCashDashYear)).reduce((s,e)=>s+Number(e.amount||0),0);
 
  const rows = entries.map(e=>`
    <div class="bg-white rounded-xl border border-slate-100 shadow-sm p-3.5 flex items-center justify-between gap-3">
      <div class="min-w-0 flex-1">
        <p class="text-sm font-medium text-slate-800">${escapeHtml(e.note||'(ไม่มีหมายเหตุ)')}</p>
        <p class="text-xs text-slate-400 mt-0.5">${fmtDate(e.date)} ${e.time?'· '+escapeHtml(e.time):''} · รวมวันนี้ ฿${fmtMoney(byDay[e.date])}</p>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <p class="font-bold text-slate-800">฿${fmtMoney(e.amount)}</p>
        <button onclick="deletePettyCash('${e.id}')" class="text-slate-300 hover:text-red-500 text-sm">✕</button>
      </div>
    </div>`).join('');
 
  c.innerHTML = `
    <div class="flex items-center justify-between mb-5 flex-wrap gap-3">
      <h2 class="text-xl font-bold text-slate-800 heading-font">เบิกเงิน / ค่าใช้จ่ายทั่วไป</h2>
      <button onclick="openAddPettyCash()" class="bg-rose-600 hover:bg-rose-700 text-white text-sm font-medium px-4 py-2 rounded-lg shadow-sm">+ เพิ่มรายการเบิกเงิน</button>
    </div>
 
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4">
        <div class="flex items-center justify-between mb-2">
          <p class="text-xs text-slate-400 font-medium">ยอดรวมรายเดือน</p>
          <input type="month" value="${pettyCashDashMonth}" onchange="setPettyCashDashMonth(this.value)" class="border border-slate-200 rounded-lg px-2 py-1 text-xs">
        </div>
        <p class="text-2xl font-bold text-slate-800 heading-font">฿${fmtMoney(monthTotal)}</p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4">
        <div class="flex items-center justify-between mb-2">
          <p class="text-xs text-slate-400 font-medium">ยอดรวมรายปี</p>
          <input type="number" value="${pettyCashDashYear}" onchange="setPettyCashDashYear(this.value)" class="border border-slate-200 rounded-lg px-2 py-1 text-xs w-24">
        </div>
        <p class="text-2xl font-bold text-slate-800 heading-font">฿${fmtMoney(yearTotal)}</p>
      </div>
    </div>
 
    <div class="space-y-2.5">
      ${rows || '<p class="text-center text-slate-400 py-16 bg-white rounded-2xl border border-slate-100">ยังไม่มีรายการเบิกเงิน</p>'}
    </div>
  `;
}
 
function openAddPettyCash(){
  const now = new Date();
  document.getElementById('form-modal-title').textContent = 'เพิ่มรายการเบิกเงิน';
  document.getElementById('form-modal-body').innerHTML = `
    <label class="block text-xs font-medium text-slate-500 mb-1">วันที่</label>
    <input id="pc-date" type="date" value="${todayISO()}" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm mb-2">
    <label class="block text-xs font-medium text-slate-500 mb-1">เวลา</label>
    <input id="pc-time" type="time" value="${now.toTimeString().slice(0,5)}" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm mb-2">
    <label class="block text-xs font-medium text-slate-500 mb-1">จำนวนเงิน</label>
    <input id="pc-amount" type="number" step="0.01" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm mb-2" placeholder="0.00">
    <label class="block text-xs font-medium text-slate-500 mb-1">หมายเหตุ / เหตุผล</label>
    <input id="pc-note" type="text" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm" placeholder="เช่น ซื้ออุปกรณ์ทำความสะอาด">
  `;
  document.getElementById('btn-form-ok').onclick = ()=>{
    const amount = Number(document.getElementById('pc-amount').value)||0;
    if(amount<=0){ toast('กรุณาใส่จำนวนเงิน','error'); return; }
    state.pettyCash.push({
      id: uid(), date: document.getElementById('pc-date').value, time: document.getElementById('pc-time').value,
      amount, note: document.getElementById('pc-note').value.trim(),
    });
    scheduleSave(); closeFormModal(); renderContent(); toast('เพิ่มรายการเบิกเงินแล้ว');
  };
  document.getElementById('form-modal').classList.remove('hidden');
}
function deletePettyCash(id){
  askConfirm('ลบรายการเบิกเงิน','ต้องการลบรายการนี้ใช่หรือไม่?', ()=>{
    state.pettyCash = state.pettyCash.filter(x=>x.id!==id); scheduleSave(); renderContent(); toast('ลบแล้ว');
  });
}
 
/* ============================ INIT ============================ */
(async function init(){
  await loadState();
  renderSidebar();
  renderContent();
})();
</script>

<script>
/* ============================ STATE ============================ */
const STORAGE_KEY = 'biglaundry-state';
let state = null;
let saveTimer = null;
let activeSection = 'dashboard';
let dashboardChartMode = 'month'; // 'month' | 'year'
let dashboardFilterFrom = '';
let dashboardFilterTo = '';
let draftDoc = null; // ใบส่งของ/บิลเงินสด กำลังกรอก
 
function uid(){ return Date.now().toString(36)+Math.random().toString(36).slice(2,7); }
 
function defaultState(){
  return {
    companyName: 'BIGBOOM LAUNDRY',
    companyAddress: 'บ.49/9 ม.10 ต.ชะอม อ.แก่งคอย จ.สระบุรี',
    companyPhone: '092-261-6579',
    companyEmail: 'bigboom.laundry@email.com',
    companyLogo: null,
    themeColor: '#e11d48',
    mode: 'live',
    sections: [
      {id:'dashboard', label:'แดชบอร์ด', builtin:'dashboard', removable:false},
      {id:'payments', label:'การชำระเงิน', builtin:'payments', removable:true},
      {id:'delivery', label:'ใบส่งของ / บิลเงินสด', builtin:'delivery', removable:true},
      {id:'employees', label:'พนักงาน', builtin:'employees', removable:true},
      {id:'stock', label:'สต็อกน้ำยา', builtin:'stock', removable:true},
      {id:'expenses', label:'รายจ่ายต่อเดือน', builtin:'expenses', removable:true},
      {id:'pettycash', label:'เบิกเงิน / ค่าใช้จ่ายทั่วไป', builtin:'pettycash', removable:true},
    ],
    customers: [], // {id,name,address,contact}
    documents: [], // {id,type:'delivery'|'cash',docNo,date,customerId,customerName,customerAddress,customerContact,projectName,items:[{name,desc,qty,price}],total,terms,payment}
    payments: [], // {id,customerId,customerName,amount,status,note,date}
    employees: [], // {id,name,nickname,position,photo,startDate,dailyWage,otRate,baseSalary,workRecords:[{id,date,present,otHours,advance,note}]}
    chemicals: [
      {id:uid(), name:'น้ำยาซักผ้า', qty:0, unit:'ลิตร', threshold:10, pricePerUnit:0, purchases:[]},
      {id:uid(), name:'น้ำยาปรับผ้านุ่ม', qty:0, unit:'ลิตร', threshold:10, pricePerUnit:0, purchases:[]},
      {id:uid(), name:'น้ำยาฟอกขาว', qty:0, unit:'ลิตร', threshold:5, pricePerUnit:0, purchases:[]},
    ],
    itemCatalog: [], // {id,name,desc,price} รายการสินค้า/บริการที่บันทึกไว้
    expenses: [], // {id,name,category,amount,dueDay,notes,paid,slip}
    pettyCash: [], // {id,date,time,amount,note}
    lineSettings: {token:'', userId:''},
    terms: 'หากมีข้อสงสัยกรุณาติดต่อทีมงานตามเบอร์โทรศัพท์ที่แจ้งด้านบน',
    paymentInfo: 'ธนาคารไทยพาณิชย์ (SCB)\nชื่อบัญชี: กศิภิอร รักษา\nเลขที่บัญชี: 687-243-3142',
    customNotes: {}, // สำหรับหัวข้อที่ผู้ใช้เพิ่มเอง {sectionId: text}
  };
}
 
 
async function loadState(){
  try{
    const r = await window.storage.get(STORAGE_KEY, false);
    state = r ? JSON.parse(r.value) : defaultState();
  }catch(e){
    state = defaultState();
  }
  const d = defaultState();
  if(!state.itemCatalog) state.itemCatalog = [];
  if(!state.customNotes) state.customNotes = {};
  if(!state.expenses) state.expenses = [];
  if(!state.pettyCash) state.pettyCash = [];
  if(!state.lineSettings) state.lineSettings = {token:'', userId:''};
  if(state.terms===undefined) state.terms = d.terms;
  if(state.paymentInfo===undefined) state.paymentInfo = d.paymentInfo;
  if(!state.themeColor) state.themeColor = d.themeColor;
  if(state.companyPhone===undefined) state.companyPhone = d.companyPhone;
  if(state.companyEmail===undefined) state.companyEmail = d.companyEmail;
  if(state.companyLogo===undefined) state.companyLogo = null;
  if(!state.sections.some(s=>s.builtin==='expenses')){
    state.sections.push({id:'expenses', label:'รายจ่ายต่อเดือน', builtin:'expenses', removable:true});
  }
  if(!state.sections.some(s=>s.builtin==='pettycash')){
    state.sections.push({id:'pettycash', label:'เบิกเงิน / ค่าใช้จ่ายทั่วไป', builtin:'pettycash', removable:true});
  }
  // migrate chemicals to include costing fields
  state.chemicals.forEach(ch=>{
    if(ch.pricePerUnit===undefined) ch.pricePerUnit = 0;
    if(!ch.purchases) ch.purchases = [];
  });
  // migrate employees to include payroll fields
  state.employees.forEach(emp=>{
    if(emp.dailyWage===undefined) emp.dailyWage = 0;
    if(emp.otRate===undefined) emp.otRate = 0;
    if(emp.baseSalary===undefined) emp.baseSalary = 0;
    if(emp.startDate===undefined) emp.startDate = '';
    if(!emp.workRecords) emp.workRecords = [];
  });
  document.getElementById('mode-select').value = state.mode || 'live';
}
 
function scheduleSave(){
  const el = document.getElementById('save-indicator');
  const txt = document.getElementById('save-indicator-text');
  el.className = 'inline-flex items-center gap-2 bg-amber-50 border border-amber-100 rounded-xl px-3 py-2 text-xs font-medium text-amber-700';
  txt.textContent = 'กำลังบันทึก...';
  clearTimeout(saveTimer);

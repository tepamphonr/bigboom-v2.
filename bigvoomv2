/* ============================ HELPERS ============================ */
function escapeHtml(s){ return (s??'').toString().replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function fmtMoney(n){ return (Number(n)||0).toLocaleString('th-TH',{minimumFractionDigits:2, maximumFractionDigits:2}); }
function fmtDate(d){ if(!d) return '-'; const dt=new Date(d); return dt.toLocaleDateString('th-TH',{day:'2-digit',month:'short',year:'2-digit'}); }
function todayISO(){ return new Date().toISOString().slice(0,10); }
function isSameDay(iso, d2){ return iso===d2; }
function isSameMonth(iso, y, m){ const d=new Date(iso); return d.getFullYear()===y && d.getMonth()===m; }
function isSameYear(iso, y){ return new Date(iso).getFullYear()===y; }
 
/* ============================ RENDER ROUTER ============================ */
function renderContent(){
  const c = document.getElementById('content');
  const sec = state.sections.find(s=>s.id===activeSection) || state.sections[0];
  if(!sec){ c.innerHTML=''; return; }
  if(sec.builtin==='dashboard') return renderDashboard(c);
  if(sec.builtin==='payments') return renderPayments(c);
  if(sec.builtin==='delivery') return renderDelivery(c);
  if(sec.builtin==='employees') return renderEmployees(c);
  if(sec.builtin==='stock') return renderStock(c);
  if(sec.builtin==='expenses') return renderExpenses(c);
  if(sec.builtin==='pettycash') return renderPettyCash(c);
  return renderCustomSection(c, sec);
}
 

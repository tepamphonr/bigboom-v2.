/* ============================ DASHBOARD ============================ */
function docsInDashboardRange(docs){
  if(!dashboardFilterFrom && !dashboardFilterTo) return docs;
  return docs.filter(d=> (!dashboardFilterFrom || d.date>=dashboardFilterFrom) && (!dashboardFilterTo || d.date<=dashboardFilterTo));
}
function resetDashboardFilter(){ dashboardFilterFrom=''; dashboardFilterTo=''; renderContent(); }
function setDashboardFilter(field, val){ if(field==='from') dashboardFilterFrom=val; else dashboardFilterTo=val; renderContent(); }
function computeChartBars(filteredDocs){
  const sum = arr => arr.reduce((s,d)=>s+Number(d.total||0),0);
  let bars = [];
  if(dashboardFilterFrom && dashboardFilterTo){
    const from = new Date(dashboardFilterFrom), to = new Date(dashboardFilterTo);
    const spanDays = Math.round((to-from)/86400000)+1;
    if(spanDays>0 && spanDays<=31){
      for(let i=0;i<spanDays;i++){
        const dt = new Date(from); dt.setDate(dt.getDate()+i);
        const iso = dt.toISOString().slice(0,10);
        bars.push({label:dt.getDate()+'', val: sum(filteredDocs.filter(x=>x.date===iso))});
      }
    } else if(spanDays>31){
      let cur = new Date(from.getFullYear(), from.getMonth(), 1);
      const end = new Date(to.getFullYear(), to.getMonth(), 1);
      let guard=0;
      while(cur<=end && guard<60){
        const y=cur.getFullYear(), m=cur.getMonth();
        bars.push({label:(m+1)+'/'+(''+y).slice(-2), val: sum(filteredDocs.filter(x=>isSameMonth(x.date,y,m)))});
        cur.setMonth(cur.getMonth()+1); guard++;
      }
    }
  } else if(dashboardChartMode==='month'){
    const now = new Date();
    for(let m=0;m<12;m++) bars.push({label:(m+1)+'', val: sum(filteredDocs.filter(d=>isSameMonth(d.date, now.getFullYear(), m)))});
  } else {
    const now = new Date();
    for(let y=now.getFullYear()-4;y<=now.getFullYear();y++) bars.push({label:''+y, val: sum(filteredDocs.filter(d=>isSameYear(d.date, y)))});
  }
  return bars;
}
 

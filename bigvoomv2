function uploadLogo(input){
  const file = input.files[0]; if(!file) return;
  if(file.size > 800*1024){ toast('ไฟล์โลโก้ใหญ่เกินไป กรุณาใช้รูปขนาดเล็กกว่า 800KB','error'); return; }
  const reader = new FileReader();
  reader.onload = e=>{ state.companyLogo = e.target.result; scheduleSave(); renderContent(); };
  reader.readAsDataURL(file);
}

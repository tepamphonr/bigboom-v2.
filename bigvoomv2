    'วันที่': d.date, 'ประเภท': d.type==='delivery'?'ใบส่งของ':'บิลเงินสด', 'เลขที่เอกสาร': d.docNo,
    'ชื่อลูกค้า': d.customerName, 'ยอดสุทธิ': Number(d.total||0)
  }));
  const ws = XLSX.utils.json_to_sheet(rows);
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, 'ประวัติเอกสาร');
  XLSX.writeFile(wb, `BIGBOOM-LAUNDRY-เอกสาร-${todayISO()}.xlsx`);
  toast('ส่งออกไฟล์ Excel แล้ว');
}
 

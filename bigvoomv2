let empPeriodFilters = {}; // {empId: {from,to}}
 
function monthRange(offsetMonths){
  offsetMonths = offsetMonths||0;
  const now = new Date();
  const from = new Date(now.getFullYear(), now.getMonth()+offsetMonths, 1);
  const to = new Date(now.getFullYear(), now.getMonth()+offsetMonths+1, 0);
  return {from: from.toISOString().slice(0,10), to: to.toISOString().slice(0,10)};
}
function getEmpPeriod(empId){
  if(!empPeriodFilters[empId]) empPeriodFilters[empId] = monthRange(0);
  return empPeriodFilters[empId];
}
function setEmpPeriod(empId, field, val){
  const p = getEmpPeriod(empId);
  p[field] = val;
  renderContent();
}
function computeEmpPay(emp, from, to){
  const records = emp.workRecords.filter(r=> (!from||r.date>=from) && (!to||r.date<=to)).sort((a,b)=> new Date(b.date)-new Date(a.date));
  const daysWorked = records.filter(r=>r.present).length;
  const otHours = records.reduce((s,r)=>s+(Number(r.otHours)||0),0);
  const advance = records.reduce((s,r)=>s+(Number(r.advance)||0),0);
  const net = (Number(emp.dailyWage)||0)*daysWorked + otHours*(Number(emp.otRate)||0) - advance;
  return {records, daysWorked, otHours, advance, net};
}
function tenureText(startDate){
  if(!startDate) return 'ยังไม่ระบุวันเริ่มงาน';
  const start = new Date(startDate); const today = new Date();
  start.setHours(0,0,0,0); today.setHours(0,0,0,0);
  if(start>today) return 'ยังไม่ถึงวันเริ่มงาน';
  const days = Math.round((today-start)/86400000);
  const years = Math.floor(days/365);
  const months = Math.floor((days%365)/30);
  const restDays = (days%365)%30;
  const parts = [];
  if(years>0) parts.push(years+' ปี');
  if(months>0) parts.push(months+' เดือน');
  parts.push(restDays+' วัน');
  return `${parts.join(' ')} (รวม ${days} วัน)`;
}
 

/* ---- Thai baht text conversion ---- */
function convertThaiBaht(num){
  if(num===null||num===undefined||isNaN(num)) return "ศูนย์บาทถ้วน";
  num = Math.round(num*100)/100;
  const txtNum = ["ศูนย์","หนึ่ง","สอง","สาม","สี่","ห้า","หก","เจ็ด","แปด","เก้า"];
  const txtDigit = ["","สิบ","ร้อย","พัน","หมื่น","แสน","ล้าน"];
  let str = num.toString().split(".");
  let bahtStr = str[0];
  let satangStr = str.length>1 ? str[1] : "";
  let isNegative = false;
  if(bahtStr.startsWith("-")){ isNegative = true; bahtStr = bahtStr.substring(1); }
  let result = "";
  if(parseInt(bahtStr)===0 && (satangStr===""||parseInt(satangStr)===0)) return "ศูนย์บาทถ้วน";
  if(parseInt(bahtStr)>0) result += convertBahtSection(bahtStr, txtNum, txtDigit) + "บาท";
  if(satangStr!=="" && parseInt(satangStr)>0){
    if(satangStr.length===1) satangStr += "0";
    result += convertBahtSection(satangStr.substring(0,2), txtNum, txtDigit) + "สตางค์";
  } else { result += "ถ้วน"; }
  if(isNegative) result = "ลบ"+result;
  return result;
}
function convertBahtSection(numberStr, txtNum, txtDigit){
  let result = "";
  let len = numberStr.length;
  for(let i=0;i<len;i++){
    let digit = parseInt(numberStr.charAt(i));
    let position = len-i-1;
    if(digit!==0){
      if(position===0 && digit===1 && len>1) result += "เอ็ด";
      else if(position===1 && digit===2) result += "ยี่สิบ";
      else if(position===1 && digit===1) result += "สิบ";
      else result += txtNum[digit]+txtDigit[position];
    }
  }
  return result;
}
 

function computeCustomerStatement(){
  if(!stmtCustomerId) return {docs:[], itemSummary:[], total:0, customer:null};
  const customer = state.customers.find(x=>x.id===stmtCustomerId);
  const docs = state.documents.filter(d=> d.customerId===stmtCustomerId
    && (!stmtFrom || d.date>=stmtFrom) && (!stmtTo || d.date<=stmtTo)
  ).sort((a,b)=> new Date(a.date)-new Date(b.date));
  const byItem = {};
  docs.forEach(d=> d.items.forEach(it=>{
    const key = it.name;
    if(!byItem[key]) byItem[key] = {name:it.name, qty:0, price:it.price, total:0};
    byItem[key].qty += Number(it.qty)||0;
    byItem[key].price = it.price;
    byItem[key].total += (Number(it.qty)||0)*(Number(it.price)||0);
  }));
  const itemSummary = Object.values(byItem);
  const total = docs.reduce((s,d)=>s+Number(d.total||0),0);
  return {docs, itemSummary, total, customer};
}
